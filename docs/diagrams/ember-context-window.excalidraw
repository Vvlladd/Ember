   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ContextCompactor.compact\n1. keep 4 most recent entries VERBATIM\n2. older \u2192 text (drop stale \u27e6memory\u27e7 blocks)\n3. provider.summarizeStructured \u2192 ConversationSummary\n(@Generable: summary + \u22645 topics + \u22645 preferences)\n4. preferences harvested \u2192 saveNoteIfNovel",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "compact",
   "originalText": "ContextCompactor.compact\n1. keep 4 most recent entries VERBATIM\n2. older \u2192 text (drop stale \u27e6memory\u27e7 blocks)\n3. provider.summarizeStructured \u2192 ConversationSummary\n(@Generable: summary + \u22645 topics + \u22645 preferences)\n4. preferences harvested \u2192 saveNoteIfNovel",
   "lineHeight": 1.25,
   "baseline": 13
  },
